{
  "name": "stellita",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "seed:templates": "tsx scripts/seed-templates.ts",
    "build": "tsc -b && vite build",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:env": "tsx scripts/check-env-example.ts",
    "check:forbidden-patterns": "tsx scripts/check-forbidden-patterns.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:migrations": "tsx --test tests/profile-credit-counters.test.ts tests/clone-project-visibility.test.ts",
    "test": "tsx --test tests/profile-credit-counters.test.ts tests/project-error-helper.test.ts tests/shared-project-seo.test.ts tests/server-error-response.test.ts server/_lib/deploy.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.1",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "^7.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.0",
    "stellar-hd-wallet": "^1.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0"
  }
}
