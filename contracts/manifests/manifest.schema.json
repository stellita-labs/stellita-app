{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellita.app/schemas/manifest.schema.json",
  "title": "Stellita contract manifest",
  "description": "One manifest per contract in the LLM catalog. Structural rules live here; the cross-file rules (wasmPath exists on disk, argsFromConfig matches config[].key, scType is supported by the deploy serialiser) are asserted by scripts/check-manifests.ts.",
  "type": "object",
  "required": ["id", "name", "description", "type", "category", "config", "methods"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "useFor": { "type": "string" },
    "type": { "enum": ["deployable", "deployed"] },
    "category": { "type": "string", "minLength": 1 },
    "wasmPath": {
      "type": "string",
      "pattern": "^contracts/wasm/[a-z0-9][a-z0-9-]*\\.wasm$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^C[A-Z2-7]{55}$"
    },
    "network": { "enum": ["testnet", "mainnet"] },
    "init": {
      "type": "object",
      "required": ["method", "argsFromConfig"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "argsFromConfig": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "number", "address"] },
          "scType": { "enum": ["string", "address", "i128", "u32", "u64", "bool"] },
          "default": {}
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "args", "returns", "mutates"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "returns": { "type": "string" },
          "mutates": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "deployable" } }, "required": ["type"] },
      "then": { "required": ["wasmPath", "init"] },
      "else": { "required": ["contractId", "network"] }
    }
  ]
}
