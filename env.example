# --- APP & API ---
VITE_API_BASE=http://localhost:8787    # frontend → backend. Prod: https://api.stellita.app
API_BASE=http://localhost:8787         # backend self-URL (OAuth callback). Prod: https://api.stellita.app
FRONTEND_ORIGIN=http://localhost:5173  # CORS origin. Prod: https://www.stellita.app
COOKIE_DOMAIN=                         # leave EMPTY for localhost. Prod only: .stellita.app

# --- Runtime (server) ---
PORT=8787                              # Express API port. Prod: 8787 (see Dockerfile)
NODE_ENV=                              # leave EMPTY locally; "production" inside containers
LOG_LEVEL=                             # leave EMPTY for "info"; one of debug|info|warn|error

# --- Stellar (testnet) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_DEPLOYER_SECRET=
FAUCET_SECRET=

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Supabase (all server-side; the browser never talks to Supabase directly) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=Stellita <noreply@stellita.app>
